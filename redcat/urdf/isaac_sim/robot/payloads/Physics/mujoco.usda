over "redcat_car"
{
    over "Physics"
    {
        def MjcActuator "fl_wheel_joint_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </redcat_car/Physics/fl_wheel_joint>
        }

        def MjcActuator "fr_wheel_joint_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </redcat_car/Physics/fr_wheel_joint>
        }

