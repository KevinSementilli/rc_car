            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </redcat_car/Physics/rl_wheel_joint>
        }

        def MjcActuator "rr_wheel_joint_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </redcat_car/Physics/rr_wheel_joint>
        }

