    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "redcat_car"
{
    over "Geometry"
    {
        over "base_link"
        {
            over "base_footprint"
            {
                over "chassis" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
                )
                {
                    bool newton:selfCollisionEnabled = 0

                    over "fl_wheel" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                    )
                    {
                    }

                    over "fr_wheel" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                    )
                    {
                    }

                    over "rl_wheel" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                    )
                    {
                    }

                    over "rr_wheel" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                    )
                    {
                    }

                    over "unitree_L2" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                    )
                    {
                    }
                }
            }
        }
    }

    over "Physics"
    {
        def PhysicsRevoluteJoint "fl_wheel_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
            custom rel physics:body0
            prepend rel physics:body0 = </redcat_car/Geometry/base_link/base_footprint/chassis>
            custom rel physics:body1
            prepend rel physics:body1 = </redcat_car/Geometry/base_link/base_footprint/chassis/fl_wheel>
            point3f physics:localPos0 = (-0.1125, 0.1405, 0.0121)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (-0.70710677, 0, 0.70710677, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsRevoluteJoint "fr_wheel_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
            custom rel physics:body0
            prepend rel physics:body0 = </redcat_car/Geometry/base_link/base_footprint/chassis>
            custom rel physics:body1
            prepend rel physics:body1 = </redcat_car/Geometry/base_link/base_footprint/chassis/fr_wheel>
            point3f physics:localPos0 = (0.1125, 0.1405, 0.0121)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0, -0.70710677, 0, 0.70710677)
            quatf physics:localRot1 = (0, -1, 0, 0)
        }

        def PhysicsRevoluteJoint "rl_wheel_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
            custom rel physics:body0
            prepend rel physics:body0 = </redcat_car/Geometry/base_link/base_footprint/chassis>
            custom rel physics:body1
            prepend rel physics:body1 = </redcat_car/Geometry/base_link/base_footprint/chassis/rl_wheel>
            point3f physics:localPos0 = (-0.1125, -0.1405, 0.0121)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (-0.70710677, 0, 0.70710677, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsRevoluteJoint "rr_wheel_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
            custom rel physics:body0
            prepend rel physics:body0 = </redcat_car/Geometry/base_link/base_footprint/chassis>
            custom rel physics:body1
            prepend rel physics:body1 = </redcat_car/Geometry/base_link/base_footprint/chassis/rr_wheel>
            point3f physics:localPos0 = (0.1125, -0.1405, 0.0121)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0, -0.70710677, 0, 0.70710677)
            quatf physics:localRot1 = (0, -1, 0, 0)
        }

        def PhysicsFixedJoint "unitree_L2_joint"
        {
            custom rel physics:body0
            prepend rel physics:body0 = </redcat_car/Geometry/base_link/base_footprint/chassis>
            custom rel physics:body1
            prepend rel physics:body1 = </redcat_car/Geometry/base_link/base_footprint/chassis/unitree_L2>
            point3f physics:localPos0 = (0, 0.1026, 0.0915)
            point3f physics:localPos1 = (0, 0, 0)
