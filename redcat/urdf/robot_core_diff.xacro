<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
    </material>

    <material name="black">
        <color rgba="0.05 0.05 0.05 1"/>
    </material>

    <xacro:property name="scale_factor" value="0.001 0.001 0.001"/>

    <!-- ****************************************************************************************** -->
    <!-- ***************************************** Base ******************************************* -->
    <!-- ****************************************************************************************** -->

    <link name="base_link"/>
    <link name="base_footprint"/>

    <joint name="base_link_joint" type="fixed">
        <parent link="base_link"/>
        <child link="base_footprint"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <joint name="chassis_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="chassis"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    
    <link name="chassis">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://redcat/meshes/car_body.stl" scale="${scale_factor}"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://redcat/meshes/collision/car_body.stl" scale="${scale_factor}"/>
            </geometry>
        </collision>
    </link>

    <!-- ****************************************************************************************** -->
    <!-- ********************************* Front  Drive  ****************************************** -->
    <!-- ****************************************************************************************** -->
    
    <joint name="fl_wheel_joint" type="continuous">
        <parent link="chassis"/>
        <child link="fl_wheel"/>
        <origin xyz="-0.1125 0.1405 0.0121" rpy="0 -${pi/2} 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <joint name="fr_wheel_joint" type="continuous">
        <parent link="chassis"/>
        <child link="fr_wheel"/>
        <origin xyz="0.1125 0.1405 0.0121" rpy="0 ${pi/2} 0"/>
        <axis xyz="0 0 -1"/>
    </joint>

    <link name="fl_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://redcat/meshes/wheel.stl" scale="${scale_factor}"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://redcat/meshes/collision/wheel.stl" scale="${scale_factor}"/>
            </geometry>
        </collision>
    </link>

    <link name="fr_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://redcat/meshes/wheel.stl" scale="${scale_factor}"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://redcat/meshes/collision/wheel.stl" scale="${scale_factor}"/>
            </geometry>
        </collision>
    </link>
    
    <!-- ****************************************************************************************** -->
    <!-- ********************************* Rear Drive  ******************************************** -->
    <!-- ****************************************************************************************** -->

    <joint name="rl_wheel_joint" type="continuous">
        <parent link="chassis"/>
        <child link="rl_wheel"/>
        <origin xyz="-0.1125 -0.1405 0.0121" rpy="0 -${pi/2} 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <joint name="rr_wheel_joint" type="continuous">
        <parent link="chassis"/>
        <child link="rr_wheel"/>
        <origin xyz="0.1125 -0.1405 0.0121" rpy="0 ${pi/2} 0"/>
        <axis xyz="0 0 -1"/>
    </joint>

    <link name="rl_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://redcat/meshes/wheel.stl" scale="${scale_factor}"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://redcat/meshes/collision/wheel.stl" scale="${scale_factor}"/>
            </geometry>
        </collision>
    </link>

    <link name="rr_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://redcat/meshes/wheel.stl" scale="${scale_factor}"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://redcat/meshes/collision/wheel.stl" scale="${scale_factor}"/>
            </geometry>
        </collision>
    </link>

</robot>